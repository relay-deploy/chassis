<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Postgres plumbing shared by every relay .NET service: schema migrations, a unit-of-work session and a durable job queue.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Relay.Chassis/Relay.Chassis.csproj" />
    <ProjectReference Include="../Relay.Chassis.Primitives/Relay.Chassis.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/Scripts/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
