<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Postgres plumbing shared by every relay .NET service, on EF Core: database setup, migrations on startup, readiness, a durable job queue and an event outbox with subscriptions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Relay.Chassis/Relay.Chassis.csproj" />
    <ProjectReference Include="../Relay.Chassis.Primitives/Relay.Chassis.Primitives.csproj" />
  </ItemGroup>
</Project>
